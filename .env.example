# ============================================================
# AQUA MONITOR — Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Simple App Authentication (client-side gate) -----------
# WARNING: This is a prototype-level access gate only.
# Values will be bundled into the client JS — do NOT treat
# these as cryptographically secure secrets.
VITE_APP_USERNAME=admin
VITE_APP_PASSWORD=aquamonitor2024

# --- Blynk Configuration ------------------------------------
# Blynk Auth Token from your Blynk console
VITE_BLYNK_TOKEN=YourBlynkAuthTokenHere

# Blynk server base URL (default: https://blynk.cloud)
VITE_BLYNK_SERVER=https://blynk.cloud

# Blynk Device ID (optional — used for some API calls)
VITE_BLYNK_DEVICE_ID=

# --- Sensor Virtual Pin Mapping ------------------------------
# Update these to match your actual ESP32 datastream pins.
# Example: VITE_PIN_TEMPERATURE=V0 means Temperature → V0
VITE_PIN_TEMPERATURE=V0
VITE_PIN_PH=V1
VITE_PIN_TURBIDITY=V2
VITE_PIN_TDS=V3

# --- AI Analysis (optional) ---------------------------------
# Leave blank to disable AI analysis (graceful fallback shown)
VITE_AI_API_KEY=
VITE_AI_API_URL=https://generativelanguage.googleapis.com/v1beta
VITE_AI_MODEL=gemini-2.0-flash
